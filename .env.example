# Copy to .env.local and fill in. See the configuration table in README.md.

# Required

# Postgres with the pgvector extension, pooled connection.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Signs the sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Chat, artifacts, embeddings and speech all go through the Vercel AI Gateway.
AI_GATEWAY_API_KEY=

# Optional

# Stores the generated mp3 files. Without it every audio overview fails,
# the rest of the app works.
BLOB_READ_WRITE_TOKEN=

# Without these the Google sign-in button is the only thing missing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Derived from the environment when unset.
BETTER_AUTH_URL=

# Direct connection for drizzle-kit. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Model defaults, shown as the values that apply when unset.
AI_GATEWAY_MODEL=openai/gpt-5-mini
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_SPEECH_MODEL=openai/tts-1-hd
AI_SPEECH_VOICE=nova
